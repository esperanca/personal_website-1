    <div class="doc-head">
      <h1>Desenhando Confiança</h1>
      <div class="subtitle">Design, agentes de IA e verificabilidade em serviços financeiros</div>
      <p class="meta-info">Daniel Souza · Prévia consolidada · <strong>v0.9</strong> · 4 de julho de 2026</p>
    </div>

    <!-- ÍNDICE -->
    <nav class="toc" id="indice">
      <h2>Índice</h2>
      <ol>
        <li class="toc-part"><a href="#prefacio">Prefácio — Design e Qualidade</a><span class="status">pronto</span></li>
        <li class="toc-part"><a href="#capitulo-1">Capítulo 1 — Confiável ou só convincente?</a><span class="status">base · a encurtar</span></li>
