<section class="style-guide__section" id="cor">
  <h2 class="style-guide__section-title">Cor</h2>
  <p class="style-guide__section-desc">Definidas em <code>src/scss/utilities/_variables.scss</code>. Toda cor nova no site deve vir daqui — ver <code>docs/design-system.md</code>.</p>

  <div class="style-guide__swatches">
    <div>
      <span class="style-guide__swatch-color" style="background:#000036"></span>
      <span class="style-guide__swatch-label">$black</span>
      <span class="style-guide__swatch-value">#000036</span>
    </div>
    <div>
      <span class="style-guide__swatch-color" style="background:#ffffff"></span>
      <span class="style-guide__swatch-label">$white</span>
      <span class="style-guide__swatch-value">#ffffff</span>
    </div>
    <div>
      <span class="style-guide__swatch-color" style="background:rgb(9, 121, 250)"></span>
      <span class="style-guide__swatch-label">$accent</span>
      <span class="style-guide__swatch-value">rgb(9, 121, 250)</span>
    </div>
    <div>
      <span class="style-guide__swatch-color" style="background:#2e2e31"></span>
      <span class="style-guide__swatch-label">$gray-10</span>
      <span class="style-guide__swatch-value">#2e2e31</span>
    </div>
    <div>
      <span class="style-guide__swatch-color" style="background:#7b7a7d"></span>
      <span class="style-guide__swatch-label">$gray-6</span>
      <span class="style-guide__swatch-value">#7b7a7d</span>
    </div>
    <div>
      <span class="style-guide__swatch-color" style="background:#a5a5a6"></span>
      <span class="style-guide__swatch-label">$gray-4</span>
      <span class="style-guide__swatch-value">#a5a5a6</span>
    </div>
    <div>
      <span class="style-guide__swatch-color" style="background:#bbbbbc"></span>
      <span class="style-guide__swatch-label">$gray-3</span>
