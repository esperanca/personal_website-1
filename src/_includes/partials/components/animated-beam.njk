{#
  Animated beam: ligações animadas entre o hub (centro) e cinco apps.
  Port em SVG + JS puro do Animated Beam do Magic UI (MIT, magicui.design),
  sem React, Tailwind ou framer-motion.
  Dados em src/_data/integrations.json. Cada app aceita "icon" (nome de um
  ícone abaixo) ou "image" (caminho para um SVG/PNG próprio).
#}
{% macro beamIcon(name) %}
  {% if name == 'mail' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><path d="M3 6l9 7 9-7"/></svg>
  {% elif name == 'calendar' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
  {% elif name == 'chat' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/></svg>
  {% elif name == 'doc' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 15h6M9 18h4"/></svg>
  {% elif name == 'sheet' %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16"/><path d="M4 9.5h16M4 14.5h16M10 4v16"/></svg>
  {% else %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14"/></svg>
  {% endif %}
{% endmacro %}

{% macro beamNode(app, direction) %}
  <li class="beam__node" data-beam-node data-beam-direction="{{ direction }}">
    <span class="beam__icon">
      {% if app.image %}
        <img src="{{ app.image }}" alt="" width="24" height="24" loading="lazy">
      {% else %}
        {{ beamIcon(app.icon) }}
      {% endif %}
    </span>
    <span class="beam__label">{{ app.label }}</span>
  </li>
{% endmacro %}

<figure class="beam" data-beam>
  <div class="beam__stage">
    <svg class="beam__lines" aria-hidden="true" focusable="false"></svg>

    <ul class="beam__col" role="list">
      {% for app in integrations.apps %}{% if app.side != 'right' %}{{ beamNode(app, 'in') }}{% endif %}{% endfor %}
    </ul>

    <div class="beam__hub" data-beam-hub>
      <img src="{{ integrations.hub.image }}" alt="{{ integrations.hub.label }}" width="256" height="256" loading="lazy">
    </div>

    <ul class="beam__col" role="list">
      {% for app in integrations.apps %}{% if app.side == 'right' %}{{ beamNode(app, 'out') }}{% endif %}{% endfor %}
    </ul>
  </div>
  {% if integrations.caption %}
    <figcaption class="beam__caption">{{ integrations.caption }}</figcaption>
  {% endif %}
</figure>

<script>
  (function () {
    var root = document.querySelector('[data-beam]');
    if (!root || !window.requestAnimationFrame) return;

    var NS = 'http://www.w3.org/2000/svg';
    var DURATION = 5000; // ms por passagem
    var svg = root.querySelector('.beam__lines');
    var stage = root.querySelector('.beam__stage');
    var hub = root.querySelector('[data-beam-hub]');
    var nodes = Array.prototype.slice.call(root.querySelectorAll('[data-beam-node]'));
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var beams = [];
    var running = false;
    var frame = null;

    function el(name, attrs) {
      var node = document.createElementNS(NS, name);
      for (var k in attrs) node.setAttribute(k, attrs[k]);
      return node;
    }

    function centre(box, ref) {
      return { x: box.left - ref.left + box.width / 2, y: box.top - ref.top + box.height / 2 };
    }

    function draw() {
      var ref = stage.getBoundingClientRect();
      svg.setAttribute('viewBox', '0 0 ' + ref.width + ' ' + ref.height);
      svg.textContent = '';
      var defs = el('defs', {});
      svg.appendChild(defs);
      var h = centre(hub.getBoundingClientRect(), ref);

      beams = nodes.map(function (node, i) {
        var n = centre(node.querySelector('.beam__icon').getBoundingClientRect(), ref);
        var inbound = node.getAttribute('data-beam-direction') !== 'out';
        var a = inbound ? n : h;
        var b = inbound ? h : n;
        var mx = (a.x + b.x) / 2;
        var d = 'M' + a.x + ',' + a.y + ' C' + mx + ',' + a.y + ' ' + mx + ',' + b.y + ' ' + b.x + ',' + b.y;
        var id = 'beam-grad-' + i;

        var grad = el('linearGradient', { id: id, gradientUnits: 'userSpaceOnUse' });
        [[0, 0], [0.35, 1], [0.7, 1], [1, 0]].forEach(function (s, j) {
          grad.appendChild(el('stop', {
            offset: s[0],
            'class': j < 2 ? 'beam__stop-start' : 'beam__stop-end',
            'stop-opacity': s[1]
          }));
        });
        defs.appendChild(grad);

        svg.appendChild(el('path', { d: d, 'class': 'beam__path' }));
        if (!reduced) svg.appendChild(el('path', { d: d, 'class': 'beam__glow', stroke: 'url(#' + id + ')' }));

        return { grad: grad, a: a, b: b, offset: i / nodes.length };
      });
    }

    function tick(now) {
      beams.forEach(function (beam) {
        var p = ((now / DURATION) + beam.offset) % 1;
        var t1 = p * 1.4 - 0.4;
        var t2 = t1 + 0.4;
        beam.grad.setAttribute('x1', beam.a.x + (beam.b.x - beam.a.x) * t1);
        beam.grad.setAttribute('y1', beam.a.y + (beam.b.y - beam.a.y) * t1);
        beam.grad.setAttribute('x2', beam.a.x + (beam.b.x - beam.a.x) * t2);
        beam.grad.setAttribute('y2', beam.a.y + (beam.b.y - beam.a.y) * t2);
      });
      frame = running ? requestAnimationFrame(tick) : null;
    }

    function start() {
      if (reduced || running) return;
      running = true;
      frame = requestAnimationFrame(tick);
    }

    function stop() {
      running = false;
      if (frame) cancelAnimationFrame(frame);
      frame = null;
    }

    draw();

    if ('ResizeObserver' in window) {
      new ResizeObserver(draw).observe(stage);
    } else {
      window.addEventListener('resize', draw);
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries[0].isIntersecting ? start() : stop();
      }).observe(root);
    } else {
      start();
    }
  })();
</script>
