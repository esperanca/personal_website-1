{% from "macros/form.njk" import label, field, textarea, button %}

<form name="contact" method="POST" data-netlify="true" action="/thank-you" netlify-honeypot="bot-field">
  <ol class="[ field-list ]">
    <li class="[ field-list__field-group ]">
      {{ label("Qual é o seu nome?", "name") }}
      {{ field( "text", "name", { required: true, placeholder: "Marie Curie", autocomplete: "name", autocorrect: "off", autocapitalize: "off" } ) }}
    </li>
    <li class="[ field-list__field-group ]">
      {{ label("Qual é o seu e-mail?", "email") }}
      {{ field( "email", "email", { required: true, placeholder: "marie@curie.tld", autocomplete: "email" } ) }}
    </li>
    <li class="[ field-list__field-group ]">
      {{ label("O que você tem a dizer?", "message") }}
      {{ textarea( "message", { required: true, autocapitalize: "sentences", spellcheck: "true" } ) }}
    </li>
    <li hidden>
      <label>Não preencha este campo se você é humano: <input name="bot-field" /></label>
    </li>
  </ol>
  {{ button("Enviar") }}
</form>
