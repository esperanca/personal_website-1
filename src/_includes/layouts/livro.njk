{% extends 'layouts/page.njk' %}

{% block content %}
  <main id="main-content" tabindex="-1" class="page livro-page">
    <div class="page__header-wrapper">
      <div class="page__inner-wrapper">
        <h1>{{ title }}</h1>
      </div>
    </div>

    <div class="wrapper">
      <div class="page__inner-wrapper">
        <article class="livro-post">
          <p class="livro-meta">
            {% if subtitle %}{{ subtitle }}<br>{% endif %}
            {% if version %}v{{ version }} · {% endif %}{% if date %}<time datetime="{{ date | w3DateFilter }}" class="dt-published">{{ date | livroDate }}</time>{% endif %}{% if preface %} · {{ preface }}{% endif %}
          </p>

          <div class="livro-body">
            {{ content | safe }}
          </div>
        </article>
      </div>
    </div>
  </main>
{% endblock %}
