{% extends 'layouts/base.njk' %}

{% block content %}
  <main class="wrapper">
    <article class="post">

      <h1>{{ title }}</h1>
      <p class="meta-info">
        {% if version %}v{{ version }} · {% endif %}
        {% if date %}<time datetime="{{ date | postDate }}" class="dt-published">{{ date | postDate }}</time> · {% endif %}
        {% if preface %}<span>{{ preface }}</span>{% endif %}
        {% if subtitle %}<br><em>{{ subtitle }}</em>{% endif %}
      </p>

      <div class="post__body">
        {{ content | safe }}
      </div>

    </article>
  </main>
{% endblock %}
