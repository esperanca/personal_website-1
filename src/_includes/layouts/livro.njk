{% extends 'layouts/page.njk' %}

{% block content %}
  <main id="main-content" tabindex="-1" class="page livro-page">
    <div class="livro-page__container">
      <div class="livro-page__main">
        <header class="livro-page__header">
          <h1>{{ title }}</h1>

          {% if subtitle %}
            <p class="livro-page__subtitle">{{ subtitle }}</p>
          {% endif %}

          <p class="livro-page__meta">
            {% if preface %}
              <span>por {{ preface }}</span>
            {% endif %}
            {% if date %}
              <span> · <time datetime="{{ date | postDate }}" class="dt-published">{{ date | postDate }}</time></span>
            {% endif %}
            {% if version %}
              <span> · v{{ version }}</span>
            {% endif %}
          </p>
        </header>

        <article class="livro-page__article">
          {{ content | safe }}
        </article>
      </div>

      <aside class="livro-page__sidebar">
        <div class="livro-page__sidebar-content">
          <h2 class="livro-page__sidebar-title">{{ title }}</h2>
          {% if collection %}
            <p class="livro-page__sidebar-collection">{{ collection }}</p>
          {% endif %}
        </div>
      </aside>
    </div>
  </main>
{% endblock %}
