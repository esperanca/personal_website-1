{% extends 'layouts/page.njk' %}

{% block content %}
  <main id="main-content" tabindex="-1" class="page">
    <div class="page__header-wrapper">
      <div class="page__inner-wrapper">
        <h1>{{ collection }}</h1>
      </div>
    </div>

    <div>
      <div class="inner-wrapper">
        <header>
          <h2>{{ title }}</h2>

          {% if subtitle %}
            <p class="subtitle">{{ subtitle }}</p>
          {% endif %}

          <p class="meta-info">
            {% if preface %}
              <span>por {{ preface }}</span>
            {% endif %}
            {% if date %}
              <span> · <time datetime="{{ date | postDate }}" class="dt-published">{{ date | postDate }}</time></span>
            {% endif %}
            {% if version %}
              <span> · v{{ version }}</span>
            {% endif %}
          </p>
        </header>

        <article>
          <div class="page__content">
            {{ content | safe }}
          </div>
        </article>
      </div>
    </div>
  </main>
{% endblock %}
