{% extends 'layouts/page.njk' %}

{% block content %}
  <main id="main-content" tabindex="-1" class="page">
    <div class="page__header-wrapper">
      <div class="page__inner-wrapper">
        <h1>{{ collection }}</h1>
      </div>
    </div>

    <div class="wrapper">
      <article class="post">
        <h1>{{ title }}</h1>

        {% if subtitle %}
          <p class="meta-subtitle">{{ subtitle }}</p>
        {% endif %}

        <p class="meta-info">
          {% if preface %}
            <span>por {{ preface }}</span>
          {% endif %}
          {% if date %}
            <span> · <time datetime="{{ date | postDate }}" class="dt-published">{{ date | postDate }}</time></span>
          {% endif %}
          {% if version %}
            <span> · v{{ version }}</span>
          {% endif %}
        </p>

        <div class="post__body">
          {{ content | safe }}
        </div>
      </article>
    </div>
  </main>
{% endblock %}
