{% extends 'layouts/page.njk' %}

{% block content %}
  <main id="main-content" tabindex="-1" class="page">
    <div class="wrapper">
      <article class="livro-article">
        <header class="livro-article__header">
          <h1>{{ title }}</h1>

          {% if subtitle %}
            <p class="livro-article__subtitle">{{ subtitle }}</p>
          {% endif %}

          <p class="livro-article__meta">
            {% if preface %}
              <span>por {{ preface }}</span>
            {% endif %}
            {% if date %}
              <span> · <time datetime="{{ date | postDate }}" class="dt-published">{{ date | postDate }}</time></span>
            {% endif %}
            {% if version %}
              <span> · v{{ version }}</span>
            {% endif %}
          </p>
        </header>

        <div class="livro-article__body">
          {{ content | safe }}
        </div>
      </article>
    </div>
  </main>
{% endblock %}
