<!DOCTYPE html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml"/>
    <link rel="icon" href="{{ site.faviconPath }}" type="image/png"/>
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    {% include "partials/global/meta-info.njk" %}
    <script>
      document
        .documentElement
        .classList
        .remove('no-js');
    </script>
    <style>
      {% include "css/style.css" %}
    </style>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Daniel Souza",
      "url": "https://danielsouza.com",
      "description": "Arquiteto de Informação e Pesquisador de UX",
      "email": "ola@danielsouza.com",
      "jobTitle": "Information Architect",
      "sameAs": [
        "https://github.com/esperanca",
        "https://www.linkedin.com/in/danielsouza/"
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Daniel Souza",
      "url": "https://danielsouza.com",
      "logo": "https://danielsouza.com/images/favicon.png",
      "sameAs": [
        "https://github.com/esperanca",
        "https://www.linkedin.com/in/danielsouza/"
      ]
    }
    </script>
    {% block head %}{% endblock %}
  </head>
  <body>
    {% include "partials/global/site-head.njk" %}
    {% block content %}{% endblock content %}
    {% include "partials/global/site-foot.njk" %}
    {% block foot %}{% endblock %}

    <script>
      if (window.netlifyIdentity) {
        window
          .netlifyIdentity
          .on("init", user => {
            if (!user) {
              window
                .netlifyIdentity
                .on("login", () => {
                  document.location.href = "/admin/";
                });
            }
          });
      }
    </script>
  </body>
</html>